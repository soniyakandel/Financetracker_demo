# Copy this file to ".env" and fill in real values.
# The real .env is git-ignored so secrets never reach the repository.

# Which config class to load: development | production
FLASK_ENV=development

# Signs the session cookie and CSRF tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# Database connection string (SQLite by default)
DATABASE_URL=sqlite:///finance.db

# How long a session may sit idle before it is killed (minutes)
SESSION_IDLE_MINUTES=30

# Hard cap on session lifetime regardless of activity (hours)
SESSION_ABSOLUTE_HOURS=12

# Login security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Two-factor one-time password settings
OTP_VALID_MINUTES=5
OTP_MAX_ATTEMPTS=3

# How long an emailed password reset link stays usable (minutes)
PASSWORD_RESET_VALID_MINUTES=30

# Outgoing email (SMTP). Leave MAIL_SERVER empty to run without a mail
# account: codes and reset links then go to the console and logs/otp.log.
MAIL_ENABLED=true
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=Finance Tracker <no-reply@localhost>
MAIL_TIMEOUT=15

# Production server settings (run.py)
FORCE_HTTPS=false
HOST=127.0.0.1
PORT=5000
WEB_THREADS=8

# Reverse proxies in front of the app (0 = none)
TRUSTED_PROXY_HOPS=0

# Rate-limit counter store (redis://... when running several workers)
RATELIMIT_STORAGE_URI=memory://

# JSON API tokens
JWT_SECRET_KEY=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
