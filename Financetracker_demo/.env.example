# Copy this file to ".env" and fill in real values.
# The real .env is git-ignored so secrets never reach the repository.

# Which config class to load: development | production
FLASK_ENV=development


# Signs the session cookie and CSRF tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# Database connection string (SQLite by default)
DATABASE_URL=sqlite:///finance.db

# How long a session may sit idle before it is killed (minutes)
SESSION_IDLE_MINUTES=30

# Hard cap on session lifetime regardless of activity (hours)
SESSION_ABSOLUTE_HOURS=12

# Login security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Two-factor one-time password settings
OTP_VALID_MINUTES=5
OTP_MAX_ATTEMPTS=3

# JSON API tokens
JWT_SECRET_KEY=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
